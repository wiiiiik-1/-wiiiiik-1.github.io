---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { groupByYear, sortPosts } from "../utils";

const posts = sortPosts(
  await getCollection("posts", ({ data }) => !data.draft),
);
const years = groupByYear(posts);

const monthDay = new Intl.DateTimeFormat("zh-CN", {
  month: "2-digit",
  day: "2-digit",
});
---

<BaseLayout title="归档" description="按时间浏览全部讲义笔记。">
  <header class="page-header">
    <div class="container">
      <p class="page-kicker">Archive</p>
      <h1 class="page-title">归档</h1>
      <p class="page-description">共 {posts.length} 篇笔记，按时间从新到旧排列。</p>
    </div>
  </header>

  <div class="container page-body">
    {years.map(({ year, posts: yearPosts }) => (
      <section class="archive-year">
        <h2>{year}</h2>
        <div class="archive-list">
          {yearPosts.map((post) => (
            <div class="archive-item">
              <time datetime={post.data.date.toISOString()}>
                {monthDay.format(post.data.date).replace("/", ".")}
              </time>
              <a href={`/posts/${post.id}/`}>{post.data.title}</a>
            </div>
          ))}
        </div>
      </section>
    ))}

    {posts.length === 0 && <p style="color:var(--muted)">还没有公开的笔记。</p>}
  </div>
</BaseLayout>
